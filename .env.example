# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Токен бота от @BotFather. Без него запускается только веб-панель и API.
TELEGRAM_BOT_TOKEN=

с

# Любой OpenAI-совместимый API. Без ключа бот понимает только простые траты («кофе 350»).
# Groq (бесплатный тариф): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Запасные модели через запятую: если основная упёрлась в лимит, бот переключится на следующую.
# У Groq лимиты бесплатного тарифа считаются для каждой модели отдельно.
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
LLM_TIMEOUT=60s

# Другие провайдеры, например:
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1       LLM_MODEL=openai/gpt-oss-120b
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4.1-mini
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
# Ollama:     LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b

# Часовой пояс, в котором бот понимает «сегодня» и «вчера».
APP_TIMEZONE=Europe/Moscow

POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=budget

# Порт веб-панели на хосте: http://localhost:8080
WEB_PORT=8080

LOG_LEVEL=info
